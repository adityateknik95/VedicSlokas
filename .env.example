# VedicSlokas environment. Copy to .env.local for development; set the same keys in Vercel
# (Project → Settings → Environment Variables) for production. Never commit real values.
#
# In development every auth variable is optional:
#   no DATABASE_URL     -> an embedded Postgres (PGlite) in ./.pglite, migrated automatically
#   no RESEND_API_KEY   -> emails are written to ./.dev-outbox/<address>.json
#   no Upstash          -> in-memory rate limiting (a warning is logged)
#   no Google keys      -> the Google button is shown as unavailable
# In production all of the "required in production" ones must be set, or auth refuses to run.

# --- Site -----------------------------------------------------------------------------------
# Public origin used for links in emails, canonical URLs and Better Auth (required in production).
BETTER_AUTH_URL=http://localhost:3000
# Same origin, used by public pages for metadata/sitemaps.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth -----------------------------------------------------------------------------------
# 32+ random characters. Generate with: openssl rand -base64 32   (required in production)
BETTER_AUTH_SECRET=
# Version of the Terms/Privacy text a new user agrees to. Bump when the documents change.
TERMS_VERSION=2026-10-13

# --- Database (Neon Postgres) ----------------------------------------------------------------
# Pooled connection string from the Neon console (required in production).
DATABASE_URL=
# Local only: folder for the embedded database, or "memory" for a throwaway one.
# PGLITE_DIR=.pglite

# --- Google sign-in -------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) -------------------------------------------------------------------------
# API key from resend.com (required in production).
RESEND_API_KEY=
# A sender on a domain you verified in Resend (required in production).
EMAIL_FROM="VedicSlokas <hello@mail.example.com>"

# --- Rate limiting (Upstash Redis) ----------------------------------------------------------
# REST URL and token from the Upstash console (required in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (Cloudflare Turnstile, optional) ----------------------------------------
# Off by default. Set to true and fill both keys to show the widget on the email forms.
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Paid plan and manual payments (no payment gateway) -------------------------------------
# Who sees the paid plan: on | testers | off. "on" (the default) shows it to every signed-in
# student; "testers" only to admins and the emails below.
SUBSCRIPTIONS=on
SUBSCRIPTION_TESTERS=
# Who may join live classes: everyone (every signed-in user, while classes are a free trial)
# or plan (only students with an active monthly plan).
LIVE_CLASSES=everyone
# Monthly price in whole rupees.
SUBSCRIPTION_PRICE_INR=79
# Your own verified payment details (server side only). Leave blank to hide that method.
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=VedicSlokas
PAYMENT_BANK_HOLDER=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_IFSC=
